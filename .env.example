# POSifine Frontend (my-react-app) environment variables
# Copy to .env and adjust for your environment.

# API base URL (with /api suffix). Leave EMPTY for local development so the
# Vite dev server proxies /api to the local Flask backend (port 5000).
# For production builds/deploy, this is injected at build time (e.g. https://app.example.com/api).
# VITE_API_BASE=https://posifine22.onrender.com/api

# Mapbox is NOT used. Maps run on MapLibre GL JS with OpenFreeMap (OSM) tiles.
# No MAPBOX / map token is required or read. To use a different tile provider,
# override the style URL in src/services/api.js -> geocoding.mapStyle.
