# Local development: leave VITE_API_BASE commented out so the Vite dev server
# proxies /api to the local Flask backend on port 5000 (avoids CORS).
# For production builds, VITE_API_BASE is injected at build/deploy time.
# VITE_API_BASE=https://posifine22.onrender.com/api

# Maps use OpenFreeMap / OpenStreetMap via MapLibre GL JS — no token required.
